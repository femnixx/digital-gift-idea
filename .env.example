# Digital Love Letters - Environment Template
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Project ID for CLI
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your_project_id

# Neon Database Configuration
NEON_DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require&channel_binding=require
NEON_AUTH_URL=https://your-neon-project.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://your-neon-project.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Digital Love Letters"

# Authentication
# Supabase Auth handles this - no additional config needed

# Storage
# Supabase Storage bucket name: 'media'

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=

# Optional: Error tracking
# SENTRY_DSN=