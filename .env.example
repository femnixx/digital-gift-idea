# Neon Database Configuration
NEON_DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require&channel_binding=require

# Neon Auth Configuration
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-project.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://your-neon-project.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-project.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://your-neon-project.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_AUDIENCE=neondb
NEON_AUTH_GOOGLE_ENABLED=false
NEON_AUTH_GOOGLE_PATH=/oauth2/authorization/google

# Neon Object Storage Configuration (S3-compatible)
AWS_ENDPOINT_URL_S3="https://your-neon-storage-endpoint.storage.c-6.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="us-east-2"

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Digital Love Letters"

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=

# Optional: Error tracking
# SENTRY_DSN=
